{
 "schema": "cardo/project-schema/v1",
 "packageSchema": "cardo/project-package/v1",
 "note": "项目包契约的机读规则。viewer/project.js 与 scripts/project_pack.py 读同一份文件做校验，两边判定口径一致；desc 供人阅读，不参与校验。",
 "rules": [
  {"path": "schema", "type": "string", "enum": ["cardo/project-package/v1"], "desc": "契约版本，固定为 cardo/project-package/v1"},
  {"path": "project", "type": "object", "desc": "项目基本信息"},
  {"path": "project.id", "type": "string", "desc": "项目标识，仅用字母数字与连字符；用于区分本地标注缓存"},
  {"path": "project.name", "type": "string", "desc": "项目名称，显示在页面标题"},
  {"path": "project.subtitle", "type": "string", "required": false, "desc": "标题后缀，缺省为「二维图层浏览」"},
  {"path": "project.description", "type": "string", "required": false, "desc": "标题卡第二行，例如影像分辨率与覆盖面积"},
  {"path": "project.client", "type": "string", "required": false, "desc": "委托方/编制单位"},
  {"path": "project.date", "type": "string", "required": false, "desc": "数据日期，YYYY-MM-DD"},

  {"path": "crs", "type": "object", "desc": "坐标与范围"},
  {"path": "crs.epsg", "type": "integer", "desc": "投影坐标系 EPSG 代码"},
  {"path": "crs.name", "type": "string", "desc": "投影坐标系全名"},
  {"path": "crs.shortName", "type": "string", "required": false, "desc": "页面上显示的简称，缺省为 EPSG:<epsg>"},
  {"path": "crs.vertical", "type": "string", "required": false, "desc": "高程基准，例如 EPSG:5737"},
  {"path": "crs.origin", "type": "object", "desc": "局地坐标原点（模型局部米制 0,0 对应的投影坐标）"},
  {"path": "crs.origin.E", "type": "number", "desc": "原点东坐标（米）"},
  {"path": "crs.origin.N", "type": "number", "desc": "原点北坐标（米）"},
  {"path": "crs.origin.h", "type": "number", "required": false, "desc": "原点高程（米）"},
  {"path": "crs.extentLocalM", "type": "array", "length": 4, "items": "number", "desc": "数据范围 [xmin, ymin, xmax, ymax]，局地米制"},

  {"path": "model", "type": "object", "required": false, "desc": "三维模型（可选）。整块缺省时三维页明确提示「本包未提供三维模型」"},
  {"path": "model.tileset", "type": "string", "requiredWhenPresent": "model", "desc": "3D Tiles 入口，相对项目包目录"},
  {"path": "model.views", "type": "object", "required": false, "desc": "四个机位覆盖：overview/oblique/close/loddemo，每项 {headingDeg, pitchDeg, rangeFactor}"},

  {"path": "layers", "type": "array", "minItems": 1, "desc": "图层清单，数组顺序即图层面板顺序"},
  {"path": "layers[].id", "type": "string", "desc": "图层标识，包内唯一"},
  {"path": "layers[].name", "type": "string", "desc": "图层面板显示名；矢量图层的要素数由程序自动计数"},
  {"path": "layers[].type", "type": "string", "enum": ["raster-image", "vector-polygon"], "desc": "图层类型：栅格影像 / 矢量面"},
  {"path": "layers[].file", "type": "string", "desc": "图层文件，相对项目包目录"},
  {"path": "layers[].georef", "type": "string", "requireIfSame": {"path": "type", "equals": "raster-image"}, "desc": "栅格配准文件；type 为 raster-image 时必填"},
  {"path": "layers[].default", "type": "boolean", "required": false, "desc": "初始是否勾选，缺省 false"},
  {"path": "layers[].opacity", "type": "number", "required": false, "desc": "初始不透明度 0–1，缺省 1"},
  {"path": "layers[].opacityControl", "type": "boolean", "required": false, "desc": "是否在面板上给出不透明度滑块"},
  {"path": "layers[].color", "type": "string", "required": false, "desc": "图层面板色块颜色"},
  {"path": "layers[].style", "type": "object", "required": false, "desc": "矢量样式 {color, weight, fill, fillColor, fillOpacity}"},
  {"path": "layers[].filter", "type": "object", "required": false, "desc": "矢量筛选，例如 {\"class\": \"绿地\"}"},
  {"path": "layers[].labelKey", "type": "string", "required": false, "desc": "悬停标签取哪个属性，缺省 id"},
  {"path": "layers[].popup", "type": "object", "required": false, "desc": "点选弹窗配置"},
  {"path": "layers[].popup.titleKey", "type": "string", "required": false, "desc": "弹窗标题取哪个属性，缺省 id"},
  {"path": "layers[].popup.fields", "type": "array", "required": false, "desc": "弹窗字段 [{key, label, unit, digits}]"},
  {"path": "layers[].popup.source", "type": "string", "required": false, "desc": "弹窗末尾的数据出处一行"},
  {"path": "layers[].legend", "type": "array", "required": false, "desc": "图例条目 [{color, label}]"},

  {"path": "indicators", "type": "object", "desc": "指标卡"},
  {"path": "indicators.title", "type": "string", "desc": "指标卡标题"},
  {"path": "indicators.items", "type": "array", "minItems": 1, "desc": "指标条目，按数组顺序显示"},
  {"path": "indicators.items[].label", "type": "string", "desc": "指标名"},
  {"path": "indicators.items[].value", "type": "string", "desc": "指标值（字符串，保留原样千分位与小数位）"},
  {"path": "indicators.items[].unit", "type": "string", "required": false, "desc": "单位"},
  {"path": "indicators.items[].note", "type": "string", "required": false, "desc": "口径备注，显示在指标名下方"},
  {"path": "indicators.items[].basis", "type": "string", "required": false, "desc": "实测/推断等依据标记，可选"},

  {"path": "charts", "type": "array", "required": false, "desc": "图表清单（可选），横向条形图"},
  {"path": "charts[].title", "type": "string", "desc": "图表标题"},
  {"path": "charts[].unit", "type": "string", "required": false, "desc": "数值单位"},
  {"path": "charts[].series", "type": "array", "minItems": 1, "desc": "数据系列 [{label, value, color}]"},
  {"path": "charts[].series[].label", "type": "string", "desc": "条目名"},
  {"path": "charts[].series[].value", "type": "number", "desc": "条目数值"},
  {"path": "charts[].series[].color", "type": "string", "required": false, "desc": "条形颜色"},

  {"path": "text", "type": "object", "desc": "概述与说明文字"},
  {"path": "text.overview", "type": "array", "minItems": 1, "desc": "概述段落 [{title, body}]"},
  {"path": "text.overview[].title", "type": "string", "desc": "段落小标题，例如「实测」"},
  {"path": "text.overview[].body", "type": "string", "desc": "段落正文"},
  {"path": "text.footer", "type": "string", "required": false, "desc": "页脚补充一行"},

  {"path": "attachments", "type": "array", "required": false, "desc": "附件/对照链接 [{label, href}]，href 必须是包内相对路径"},
  {"path": "attachments[].label", "type": "string", "desc": "链接文字"},
  {"path": "attachments[].href", "type": "string", "desc": "相对项目包目录的路径"},

  {"path": "dataSource", "type": "object", "required": false, "desc": "数据出处说明"},
  {"path": "dataSource.generatedBy", "type": "string", "required": false, "desc": "生成程序"},
  {"path": "dataSource.generatedAt", "type": "string", "required": false, "desc": "生成日期"},
  {"path": "dataSource.notes", "type": "string", "required": false, "desc": "补充说明（例如演示数据声明）"},

  {"path": "build", "type": "object", "required": false, "desc": "栅格自动生成配置（供 开工.py 使用，页面忽略）"},
  {"path": "build.rasterFromModel", "type": "object", "required": false, "desc": "从模型生成正射与分类栅格的参数"},
  {"path": "build.rasterFromModel.manifest", "type": "string", "requiredWhenPresent": "build.rasterFromModel", "desc": "模型清单文件，相对项目包目录"},
  {"path": "build.rasterFromModel.outDir", "type": "string", "requiredWhenPresent": "build.rasterFromModel", "desc": "输出目录，相对项目包目录"},
  {"path": "build.rasterFromModel.resM", "type": "number", "required": false, "desc": "栅格分辨率（米）"}
 ]
}
